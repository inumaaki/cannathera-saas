DATABASE_URL="postgresql://user:password@localhost:5432/cannathera?schema=public"
JWT_SECRET="generate-a-long-random-secret"
# Local development only. Never enable this in production.
EXPOSE_DEV_AUTH_CODES=false
# Optional separate secret used to encrypt temporary onboarding credentials.
# Keep this stable; changing it makes still-pending credentials unreadable.
ONBOARDING_CREDENTIAL_SECRET="generate-another-long-random-secret"
# Comma-separated when more than one web origin must call this API.
WEB_ORIGIN="http://localhost:3000"
PORT=4000

# Number of trusted reverse-proxy hops in front of the API.
# Railway/Render/Fly deployments commonly use 1; keep 0 for direct local access.
TRUST_PROXY_HOPS=0

# Used only by the explicit `npm run admin:bootstrap` maintenance command.
# Never expose these values in the frontend or commit real credentials.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="use-a-long-random-password"
# ADMIN_RESET_PASSWORD=false

# SMTP / Email Configuration (GDPR-compliant, EU host recommended)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@cannathera.de"

# Zoom Server-to-Server OAuth Credentials
ZOOM_ACCOUNT_ID="your-zoom-account-id"
ZOOM_CLIENT_ID="your-zoom-client-id"
ZOOM_CLIENT_SECRET="your-zoom-client-secret"

# Paywall bypass for pilot / demo accounts (see src/shared/paywall.ts).
# Lets pilot partners / trial patients skip the subscription paywall without a
# Stripe purchase. Leave both unset in production to enforce billing normally.
#   DISABLE_PAYWALL=true               -> disables the paywall for ALL accounts
#   PAYWALL_BYPASS_EMAILS=a@x,b@y      -> only these accounts skip it (preferred)
# DISABLE_PAYWALL=false
# PAYWALL_BYPASS_EMAILS=""

# OTP / 2FA bypass for selected pilot / demo accounts (see src/shared/paywall.ts).
# Accounts on this list authenticate with password only — no email code required.
# Use for demo accounts that have no real mailbox. Never set real user accounts here.
#   DISABLE_OTP=true                     -> disables OTP for ALL accounts (staging only)
#   OTP_BYPASS_EMAILS=    #-> only these accounts skip 2FA (preferred)
# DISABLE_OTP=false
# OTP_BYPASS_EMAILS=""

